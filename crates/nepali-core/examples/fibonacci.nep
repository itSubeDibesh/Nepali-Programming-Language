// फिबोनाची र लुप उदाहरण (Fibonacci & Loop Demo)
काम फिबोनाची(संख्या) {
  यदि संख्या <= ० भए {
    पठाउँ ०।
  }
  यदि संख्या == १ भए {
    पठाउँ १।
  }
  पठाउँ फिबोनाची(संख्या - १) + फिबोनाची(संख्या - २)।
}

राखौँ सीमा = १०।
राखौँ पद = ०।

भनौँ("--- फिबोनाची शृङ्खला (Fibonacci Series) ---")।

भएसम्म पद <= सीमा {
  राखौँ मान = फिबोनाची(पद)।
  भनौँ("पद", पद, "को मान =", मान)।
  पद = पद + १।
}
