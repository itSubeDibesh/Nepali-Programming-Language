// Step 9: साना एल्गोरिदमहरू (small algorithms, everything so far combined)

// महत्तम समापवर्तक (GCD)
काम महत्तम(a, b) {
  भएसम्म b != 0 {
    राखौँ t = b।
    b = a % b।
    a = t।
  }
  पठाउँ a।
}
भनौँ("महत्तम(48, 18) =", महत्तम(48, 18))।

// अभाज्य सङ्ख्या
काम अभाज्य(n) {
  यदि n < 2 {
    पठाउँ गलत।
  }
  राखौँ d = 2।
  भएसम्म d * d <= n {
    यदि n % d == 0 {
      पठाउँ गलत।
    }
    d = d + 1।
  }
  पठाउँ सहि।
}
राखौँ अभाज्यहरू = []।
राखौँ k = 1।
भएसम्म k <= 30 {
  यदि अभाज्य(k) {
    थप्नुहोस्(अभाज्यहरू, k)।
  }
  k = k + 1।
}
भनौँ("३० सम्मका अभाज्य:", अभाज्यहरू)।

// फिज-बज (१ देखि १५)
राखौँ n = 1।
भएसम्म n <= 15 {
  यदि n % 15 == 0 {
    भनौँ("फिजबज")।
  } नत्र यदि n % 3 == 0 {
    भनौँ("फिज")।
  } नत्र यदि n % 5 == 0 {
    भनौँ("बज")।
  } नत्र {
    भनौँ(n)।
  }
  n = n + 1।
}

// बबल सर्ट
राखौँ सङ्ख्या = [5, 2, 9, 1, 7]।
राखौँ लम्बाई = लम्बाइ(सङ्ख्या)।
राखौँ बाहिरी = 0।
भएसम्म बाहिरी < लम्बाई {
  राखौँ भित्री = 0।
  भएसम्म भित्री < लम्बाई - बाहिरी - 1 {
    यदि सङ्ख्या[भित्री] > सङ्ख्या[भित्री + 1] {
      राखौँ अस्थायी = सङ्ख्या[भित्री]।
      सङ्ख्या[भित्री] = सङ्ख्या[भित्री + 1]।
      सङ्ख्या[भित्री + 1] = अस्थायी।
    }
    भित्री = भित्री + 1।
  }
  बाहिरी = बाहिरी + 1।
}
भनौँ("क्रमबद्ध:", सङ्ख्या)।

// बाइनरी खोज (क्रमबद्ध सूचीमा)
काम खोज(सूची, लक्ष्य) {
  राखौँ तल = 0।
  राखौँ माथि = लम्बाइ(सूची) - 1।
  भएसम्म तल <= माथि {
    राखौँ बीच = (तल + माथि) / 2।
    राखौँ बीच_पूर्ण = बीच - बीच % 1।
    यदि सूची[बीच_पूर्ण] == लक्ष्य {
      पठाउँ बीच_पूर्ण।
    }
    यदि सूची[बीच_पूर्ण] < लक्ष्य {
      तल = बीच_पूर्ण + 1।
    } नत्र {
      माथि = बीच_पूर्ण - 1।
    }
  }
  पठाउँ 0 - 1।
}
भनौँ("७ को अनुक्रम:", खोज(सङ्ख्या, 7))।
भनौँ("४ को अनुक्रम:", खोज(सङ्ख्या, 4))।
