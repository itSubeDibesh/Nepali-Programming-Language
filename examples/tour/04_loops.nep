// Step 4: लुप (loops)
//
// भएसम्म = while. (लुप बाहिर निस्कने सर्त गलत भएपछि रोकिन्छ।)

राखौँ i = 1।
भएसम्म i <= 3 {
  भनौँ("गन्ती", i)।
  i = i + 1।
}

// १ देखि १०० सम्मको योग
राखौँ योग = 0।
राखौँ n = 1।
भएसम्म n <= 100 {
  योग = योग + n।
  n = n + 1।
}
भनौँ("१ देखि १०० सम्मको योग =", योग)।

// लुप भित्र लुप: ३ को पहाडा
राखौँ a = 1।
भएसम्म a <= 3 {
  राखौँ b = 1।
  भएसम्म b <= 3 {
    भनौँ(a, "x", b, "=", a * b)।
    b = b + 1।
  }
  a = a + 1।
}

// उल्टो गन्ती
राखौँ बाँकी = 3।
भएसम्म बाँकी > 0 {
  भनौँ(बाँकी)।
  बाँकी = बाँकी - 1।
}
भनौँ("उड्यो!")।
