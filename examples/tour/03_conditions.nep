// Step 3: सर्त (conditions)
//
// यदि = if, नत्र = else, नत्र यदि = else if
// र = and, वा = or, होइन = not

राखौँ अंक = 72।

यदि अंक >= 90 {
  भनौँ("ए")।
} नत्र यदि अंक >= 70 {
  भनौँ("बी")।
} नत्र {
  भनौँ("सी")।
}

// सर्तपछि "भए" (then) लेख्न ऐच्छिक छ
यदि अंक > ५० भए {
  भनौँ("पास")।
}

// र / वा / होइन
राखौँ उमेर = 20।
राखौँ सदस्य = सहि।

यदि उमेर >= 18 र सदस्य {
  भनौँ("भित्र आउनुस्")।
}

यदि उमेर < 18 वा होइन सदस्य {
  भनौँ("प्रवेश निषेध")।
} नत्र {
  भनौँ("स्वागत छ")।
}

// तुलनाको नतिजा आफैँ एउटा मान हो
भनौँ(अंक == 72, अंक != 72)।
