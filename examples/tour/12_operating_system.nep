// Step 12: भाषाबाटै अपरेटिङ सिस्टम चलाउने (files, commands, database)
//
// यी सुविधाहरू `nepali` शेल/इन्टरप्रिटरले वास्तविक Linux/macOS सँग जोड्छ।

// --- फाइल ---
ओएस_लेख्नुहोस्("/tmp/नेपाली_टुर.txt", "नमस्ते फाइल")।
भनौँ(ओएस_पढ्नुहोस्("/tmp/नेपाली_टुर.txt"))।

// --- आदेश (कुनै वास्तविक कमान्ड चलाउने) ---
// आदेश_चलाउनुहोस्(प्रोग्राम, [आर्गुमेन्टहरू]) - आर्गुमेन्ट सूचीमा दिइन्छ।
// फर्किने मान: [निकास कोड, stdout, stderr]
// आदेश शेलमार्फत होइन, सिधै चल्छ, त्यसैले $ वा ; जस्ता चिन्हले केही गर्दैनन्।
राखौँ नतिजा = आदेश_चलाउनुहोस्("echo", ["नमस्ते", "$HOME"])।
भनौँ("निकास कोड:", नतिजा[0])।
भनौँ("आउटपुट:", नतिजा[1])।

// --- डाटाबेस (वास्तविक SQLite) ---
डाटाबेस_चलाउनुहोस्("CREATE TABLE IF NOT EXISTS शहर (नाम TEXT, उचाइ INTEGER)")।
डाटाबेस_चलाउनुहोस्("DELETE FROM शहर")।
डाटाबेस_चलाउनुहोस्("INSERT INTO शहर VALUES ('काठमाडौँ', 1400)")।
डाटाबेस_चलाउनुहोस्("INSERT INTO शहर VALUES ('पोखरा', 822)")।
भनौँ(डाटाबेस_सोध्नुहोस्("SELECT नाम, उचाइ FROM शहर ORDER BY उचाइ DESC"))।
