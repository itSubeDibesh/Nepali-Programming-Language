// Step 5: कार्य (functions)
//
// काम = function, पठाउँ = return

काम नमस्कार(नाम) {
  भनौँ("नमस्ते,", नाम + "!")।
}
नमस्कार("रीता")।

काम वर्ग(x) {
  पठाउँ x * x।
}
भनौँ(वर्ग(9))।

// पुनरावृत्ति (recursion)
काम क्रमगुणित(n) {
  यदि n <= 1 {
    पठाउँ 1।
  }
  पठाउँ n * क्रमगुणित(n - 1)।
}
भनौँ("५! =", क्रमगुणित(5))।

// कार्य पनि एउटा मान हो - अर्को कार्यलाई दिन मिल्छ
काम दोहोर्याउ(f, x) {
  पठाउँ f(f(x))।
}
भनौँ(दोहोर्याउ(वर्ग, 3))।

// पठाउँ नलेखे केहीछैन फर्किन्छ
काम केही_गर() {
}
भनौँ(केही_गर())।
