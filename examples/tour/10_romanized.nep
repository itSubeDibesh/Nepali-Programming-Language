// Step 10: Romanized keywords - Nepali programming on ANY keyboard.
//
// Every Devanagari keyword has an ASCII spelling, so no input method is
// needed. Both spellings can be mixed freely in one file.
//
//   rakha = राखौँ    kaam = काम       pathau = पठाउँ    bhana = भनौँ
//   yadi  = यदि      natra = नत्र     bhaye = भए        bhayesamma = भएसम्म
//   sahi  = सहि      galat = गलत      kehichaina = केहीछैन
//   ra = र           wa = वा          hoina = होइन      aayat = आयात

kaam factorial(n) {
  yadi n <= 1 {
    pathau 1;
  }
  pathau n * factorial(n - 1);
}

rakha i = 1;
bhayesamma i <= 5 {
  bhana("factorial(" + i + ") =", factorial(i));
  i = i + 1;
}

rakha umer = 20;
yadi umer >= 18 ra hoina (umer > 60) bhaye {
  bhana("baaleg");
} natra {
  bhana("naabaaleg wa briddha");
}

// मिसाउन पनि मिल्छ (mixing both scripts)
rakha नाम = "रीता";
bhana("नमस्ते,", नाम);
भनौँ(sahi, galat, kehichaina);
