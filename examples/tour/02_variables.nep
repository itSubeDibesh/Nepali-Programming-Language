// Step 2: चर र प्रकार (variables and types)
//
// राखौँ = "let". प्रकारहरू: सङ्ख्या, पाठ, सहि/गलत, केहीछैन (null)।

राखौँ नाम = "सुमन"।
राखौँ उमेर = २५।
राखौँ उचाइ = 1.75।
राखौँ विद्यार्थी = सहि।
राखौँ केही = केहीछैन।

भनौँ(नाम, उमेर, उचाइ)।
भनौँ(विद्यार्थी, केही)।

// मान फेर्न: चरको नाम = नयाँ मान
उमेर = उमेर + १।
भनौँ("अर्को वर्ष:", उमेर)।

// गणित: + - * / %
भनौँ(7 + 3, 7 - 3, 7 * 3, 7 / 2, 7 % 3)।

// "+" ले पाठ पनि जोड्छ
भनौँ("नमस्ते " + नाम)।
भनौँ("उमेर: " + उमेर)।
