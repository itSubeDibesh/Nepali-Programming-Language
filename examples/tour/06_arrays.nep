// Step 6: सूची (arrays)
//
// [a, b, c], सूची[अनुक्रम] (० बाट सुरु), लम्बाइ(सूची), थप्नुहोस्(सूची, मान)

राखौँ फल = ["आँप", "केरा", "स्याउ"]।
भनौँ(फल, लम्बाइ(फल))।
भनौँ(फल[0])।

// एउटा ठाउँको मान फेर्ने
फल[1] = "सुन्तला"।

// अन्त्यमा थप्ने
थप्नुहोस्(फल, "अंगुर")।
भनौँ(फल)।

// सबै तत्त्वमा घुम्ने
राखौँ i = 0।
भएसम्म i < लम्बाइ(फल) {
  भनौँ(i + १, फल[i])।
  i = i + 1।
}

// सूची सन्दर्भ (reference) हो: अर्को नामले पनि उही सूची देखाउँछ
राखौँ अर्को = फल।
थप्नुहोस्(अर्को, "लिची")।
भनौँ(लम्बाइ(फल))।

// सूची भित्र सूची
राखौँ ग्रिड = [[1, 2], [3, 4]]।
भनौँ(ग्रिड[1][0])।

// लम्बाइ भित्री सूचीमा पनि चल्छ
भनौँ(लम्बाइ(ग्रिड), लम्बाइ(ग्रिड[0]))।

// नोट: दायरा बाहिरको अनुक्रम (जस्तै ग्रिड[5]) प्रोग्राम क्र्यास गर्दैन,
// स्पष्ट त्रुटि सन्देश दिएर रोकिन्छ।
