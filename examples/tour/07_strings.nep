// Step 7: पाठ (strings)
//
// लम्बाइ(पाठ), अक्षर(पाठ, अनुक्रम), संकेत(एक_अक्षर)
// सबै गणना Unicode कोड-पोइन्ट (अक्षर चिन्ह) मा हुन्छ, बाइटमा होइन।

राखौँ शब्द = "नेपाल"।
भनौँ(लम्बाइ(शब्द))।
भनौँ(अक्षर(शब्द, 0), अक्षर(शब्द, 2))।

// संकेत ले अक्षरको Unicode सङ्ख्या दिन्छ
भनौँ(संकेत("न"), संकेत("A"))।

// पाठ उल्टाउने (ASCII शब्दमा)
राखौँ अङ्ग्रेजी = "Nepal"।
राखौँ उल्टो = ""।
राखौँ i = लम्बाइ(अङ्ग्रेजी) - 1।
भएसम्म i >= 0 {
  उल्टो = उल्टो + अक्षर(अङ्ग्रेजी, i)।
  i = i - 1।
}
भनौँ(उल्टो)।

// नोट: "नेपाल" मा ५ कोड-पोइन्ट छन् (न, े, प, ा, ल) तर देखिने अक्षर ३ मात्र।
// मात्रा (े, ा) पनि छुट्टै कोड-पोइन्ट हुन्, त्यसैले देवनागरी उल्टाउँदा
// मात्रा गलत ठाउँमा पर्न सक्छ।

// पाठ तुलना
भनौँ("क" == "क", "क" == "ख")।
