// Step 8: क्लोजर (closures)
//
// भित्री कार्यले बाहिरी कार्यका चरहरू सम्झन्छ - बाहिरी कार्य सकिएपछि पनि।

काम गणक() {
  राखौँ गन्ती = 0।
  काम बढाउ() {
    गन्ती = गन्ती + 1।
    पठाउँ गन्ती।
  }
  पठाउँ बढाउ।
}

राखौँ क = गणक()।
राखौँ ख = गणक()।
भनौँ(क(), क(), क())।
// ख को आफ्नै, छुट्टै गन्ती छ
भनौँ(ख())।

// "जोड्ने" कार्य बनाउने कार्य
काम जोड्ने(n) {
  काम भित्री(x) {
    पठाउँ x + n।
  }
  पठाउँ भित्री।
}
राखौँ जोड_दश = जोड्ने(10)।
भनौँ(जोड_दश(5))।
भनौँ(जोड्ने(1)(1))।
