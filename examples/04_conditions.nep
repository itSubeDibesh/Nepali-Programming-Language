// ०४ — सर्त (Conditions): यदि / नत्र
//
// `यदि सर्त { ... }` — सर्त सहि भए मात्र भित्रको काम हुन्छ।
// `नत्र { ... }` — नत्र (otherwise) सर्त गलत भए यो हुन्छ।
// `भए` (then) लेख्नु वैकल्पिक हो: `यदि क > ० भए { ... }` पनि चल्छ।

राखौँ तापक्रम = 28।

यदि तापक्रम > 25 {
  भनौँ("तातो दिन")।
} नत्र {
  भनौँ("चिसो दिन")।
}

// तुलनाका चिन्ह:  ==  !=  <  <=  >  >=
राखौँ क = 10।
राखौँ ख = 20।
भनौँ(क == ख, क != ख, क < ख, क >= ख)।   // सर्तको नतिजा आफैँ सहि/गलत हुन्छ

// नत्र यदि — धेरै विकल्प जाँच्न
काम श्रेणी(अङ्क) {
  यदि अङ्क >= 80 भए {
    पठाउँ "प्रथम श्रेणी"।
  } नत्र यदि अङ्क >= 60 भए {
    पठाउँ "द्वितीय श्रेणी"।
  } नत्र यदि अङ्क >= 40 भए {
    पठाउँ "तृतीय श्रेणी"।
  } नत्र {
    पठाउँ "अनुत्तीर्ण"।
  }
}

भनौँ(85, श्रेणी(85))।
भनौँ(65, श्रेणी(65))।
भनौँ(45, श्रेणी(45))।
भनौँ(20, श्रेणी(20))।

// शब्दको तुलना पनि `==` / `!=` ले हुन्छ।
राखौँ भाषा = "नेपाली"।
यदि भाषा == "नेपाली" {
  भनौँ("यो नेपाली भाषा हो")।
}
