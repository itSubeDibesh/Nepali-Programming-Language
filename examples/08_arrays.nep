// ०८ — सूची (Arrays)
//
// `[क, ख, ग]` ले सूची बनाउँछ। सूचीको स्थान (index) ० बाट सुरु हुन्छ।

राखौँ फलफूल = ["आँप", "केरा", "स्याउ"]।
भनौँ(फलफूल)।
भनौँ("पहिलो:", फलफूल[0])।
भनौँ("तेस्रो:", फलफूल[2])।

// `लम्बाइ(सूची)` ले कति वटा तत्व छन् भन्ने बताउँछ।
भनौँ("जम्मा", लम्बाइ(फलफूल), "वटा")।

// स्थान दिएर मान फेर्न सकिन्छ।
फलफूल[1] = "सुन्तला"।
भनौँ(फलफूल)।

// `थप्नुहोस्(सूची, मान)` ले अन्तिममा नयाँ तत्व थप्छ।
थप्नुहोस्(फलफूल, "अङ्गुर")।
भनौँ(फलफूल, लम्बाइ(फलफूल))।

// सूचीका सबै तत्व भएसम्म लुपले पढ्ने
राखौँ अङ्कहरू = [4, 8, 15, 16, 23, 42]।
राखौँ जोड = 0।
राखौँ सबैभन्दा_ठूलो = अङ्कहरू[0]।
राखौँ i = 0।
भएसम्म i < लम्बाइ(अङ्कहरू) {
  जोड = जोड + अङ्कहरू[i]।
  यदि अङ्कहरू[i] > सबैभन्दा_ठूलो {
    सबैभन्दा_ठूलो = अङ्कहरू[i]।
  }
  i = i + 1।
}
भनौँ("जोड =", जोड, " ठूलो =", सबैभन्दा_ठूलो)।

// खाली सूची बनाएर आफैँ भर्ने: पहिलो ५ वटा वर्ग सङ्ख्या
राखौँ वर्गहरू = []।
राखौँ न = 1।
भएसम्म न <= 5 {
  थप्नुहोस्(वर्गहरू, न * न)।
  न = न + 1।
}
भनौँ(वर्गहरू)।

// सूचीभित्र सूची (मात्रिका / matrix)
राखौँ जाली = [[1, 2], [3, 4]]।
भनौँ(जाली[1][0])।

// सूचीहरू "सन्दर्भ" (reference) हुन्: दुई नामले एउटै सूची देखाउँछन्।
राखौँ क = [1, 2, 3]।
राखौँ ख = क।
ख[0] = 99।
भनौँ("क =", क)।           // क पनि बदलियो!

// सीमा बाहिरको स्थान पढ्ने प्रयास वास्तविक त्रुटि हो (यहाँ हामी प्रयास गर्दैनौँ)।
