// १० — तार्किक सञ्चालक (Logic): र / वा / होइन
//
//   क र ख   — दुवै सहि भए मात्र सहि   (and)
//   क वा ख  — कुनै एउटा सहि भए सहि    (or)
//   होइन क  — उल्टो                    (not)

भनौँ(सहि र सहि, सहि र गलत)।
भनौँ(गलत वा सहि, गलत वा गलत)।
भनौँ(होइन सहि, होइन गलत)।

// सर्तमा प्रयोग
राखौँ उमेर = 30।
राखौँ नागरिक = सहि।
यदि उमेर >= 18 र नागरिक {
  भनौँ("मतदान गर्न पाउने")।
}
यदि उमेर < 18 वा होइन नागरिक {
  भनौँ("मतदान गर्न नपाउने")।
} नत्र {
  भनौँ("कुनै रोक छैन")।
}

// लिप वर्ष: ४ ले भाग जाने, तर १०० ले जाने भए ४०० ले पनि जानुपर्ने
काम लिप_वर्ष(व) {
  पठाउँ (व % 4 == 0 र व % 100 != 0) वा व % 400 == 0।
}
भनौँ(1900, लिप_वर्ष(1900))।
भनौँ(2000, लिप_वर्ष(2000))।
भनौँ(2024, लिप_वर्ष(2024))।
भनौँ(2023, लिप_वर्ष(2023))।

// सर्ट-सर्किट: `र` मा बायाँ भाग गलत भए दायाँ भाग चलाइँदै चलाइँदैन।
// यसलाई देखाउन एउटा काम बनाऔँ जसले चलेको बेला छाप्छ।
काम जाँच(नाम, नतिजा) {
  भनौँ("  जाँच चल्यो:", नाम)।
  पठाउँ नतिजा।
}
भनौँ("१) गलत र ...")।
राखौँ क = जाँच("क", गलत) र जाँच("ख", सहि)।     // "ख" कहिल्यै चल्दैन
भनौँ("नतिजा:", क)।
भनौँ("२) सहि वा ...")।
राखौँ ख = जाँच("ग", सहि) वा जाँच("घ", सहि)।    // "घ" कहिल्यै चल्दैन
भनौँ("नतिजा:", ख)।
भनौँ("३) सहि र ...")।
राखौँ ग = जाँच("ङ", सहि) र जाँच("च", सहि)।     // दुवै चल्छन्
भनौँ("नतिजा:", ग)।
