// ०७ — पुनरावृत्ति (Recursion)
//
// आफैँलाई बोलाउने काम। दुई कुरा चाहिन्छ:
//   १) आधार अवस्था (base case) — जहाँ रोकिने
//   २) पुनरावर्ती अवस्था — समस्यालाई सानो बनाएर आफैँलाई बोलाउने

// क्रमगुणित: ५! = ५ × ४ × ३ × २ × १
काम क्रमगुणित(न) {
  यदि न <= 1 {
    पठाउँ 1।              // आधार अवस्था
  }
  पठाउँ न * क्रमगुणित(न - 1)।
}
भनौँ("५! =", क्रमगुणित(5))।
भनौँ("१०! =", क्रमगुणित(10))।

// घात: आधार^घातांक
काम घात(आधार, घातांक) {
  यदि घातांक == 0 {
    पठाउँ 1।
  }
  पठाउँ आधार * घात(आधार, घातांक - 1)।
}
भनौँ("२^१० =", घात(2, 10))।

// महत्तम समापवर्तक (GCD) — युक्लिडको तरिका
काम मसप(क, ख) {
  यदि ख == 0 {
    पठाउँ क।
  }
  पठाउँ मसप(ख, क % ख)।
}
भनौँ("मसप(48, 18) =", मसप(48, 18))।

// अङ्कहरूको जोड: १२३४ → १+२+३+४
काम अङ्क_जोड(न) {
  यदि न < 10 {
    पठाउँ न।
  }
  // (न - न % १०) / १० = अन्तिम अङ्क हटाएको सङ्ख्या
  पठाउँ न % 10 + अङ्क_जोड((न - न % 10) / 10)।
}
भनौँ("१२३४ का अङ्कहरूको जोड =", अङ्क_जोड(1234))।

// उल्टो गन्ती, पुनरावृत्तिबाट
काम उल्टो_गन्ती(न) {
  यदि न == 0 {
    भनौँ("सुरु!")।
    पठाउँ केहीछैन।
  }
  भनौँ(न)।
  उल्टो_गन्ती(न - 1)।
}
उल्टो_गन्ती(3)।
