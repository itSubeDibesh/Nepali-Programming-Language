// १२ — फिजबज (FizzBuzz)
//
// प्रसिद्ध अन्तर्वार्ता प्रश्न: १ देखि १५ सम्म
//   ३ र ५ दुवैले भाग जाने → "फिजबज"
//   ३ ले मात्र भाग जाने     → "फिज"
//   ५ ले मात्र भाग जाने     → "बज"
//   अन्यथा                  → सङ्ख्या नै

राखौँ i = 1।
भएसम्म i <= 15 {
  यदि i % 15 == 0 {
    भनौँ("फिजबज")।
  } नत्र यदि i % 3 == 0 {
    भनौँ("फिज")।
  } नत्र यदि i % 5 == 0 {
    भनौँ("बज")।
  } नत्र {
    भनौँ(i)।
  }
  i = i + 1।
}
