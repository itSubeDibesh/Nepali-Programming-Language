// ०२ — चर (Variables)
//
// `राखौँ` (rakha) ले नयाँ चर बनाउँछ र त्यसमा मान राख्छ।

राखौँ नाम = "सीता"।
राखौँ उमेर = 21।
भनौँ(नाम, उमेर)।

// चरको मान पछि फेर्न सकिन्छ — यसपटक `राखौँ` चाहिँदैन, सिधै `=`।
उमेर = उमेर + 1।
भनौँ(नाम, "को उमेर अब", उमेर)।

// नेपालीमा चारवटा मुख्य किसिमका मान छन्:
राखौँ सङ्ख्या = 3.5।         // सङ्ख्या (पूर्ण वा दशमलव)
राखौँ शब्द = "काठमाडौँ"।      // पाठ (शब्द)
राखौँ ठिक = सहि।            // बुलियन: सहि (true)
राखौँ बेठिक = गलत।          // बुलियन: गलत (false)
राखौँ केही = केहीछैन।        // "केही पनि छैन" (null)
भनौँ(सङ्ख्या, शब्द, ठिक, बेठिक, केही)।

// अङ्कहरू देवनागरी (०-९) मा पनि लेख्न सकिन्छ — छाप्दा सधैँ सामान्य अङ्क आउँछ।
राखौँ वर्ष = २०८३।
भनौँ("वि.सं.", वर्ष)।

// चरको नाममा देवनागरी अक्षर, अङ्क र `_` चल्छ।
राखौँ पहिलो_चर = १।
राखौँ दोस्रो_चर = २।
भनौँ(पहिलो_चर + दोस्रो_चर)।

// शब्दलाई `+` ले जोड्न सकिन्छ। शब्द + सङ्ख्या गर्दा सङ्ख्या शब्दमा बदलिन्छ।
राखौँ अभिवादन = "नमस्ते " + नाम + "!"।
भनौँ(अभिवादन)।
भनौँ("उमेर: " + उमेर)।
