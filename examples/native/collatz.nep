// कोल्याट्ज: १ देखि ३०००० सम्ममा सबैभन्दा लामो शृङ्खला कुन सङ्ख्याको छ?
// (the longest Collatz chain below 30000)

काम लम्बाई(n) {
  राखौँ कदम = 0।
  भएसम्म n != 1 {
    यदि n % 2 == 0 {
      n = n / 2।
    } नत्र {
      n = 3 * n + 1।
    }
    कदम = कदम + 1।
  }
  पठाउँ कदम।
}

राखौँ सबैभन्दा_लामो = 0।
राखौँ जवाफ = 0।
राखौँ i = 1।
भएसम्म i < 30000 {
  राखौँ l = लम्बाई(i)।
  यदि l > सबैभन्दा_लामो {
    सबैभन्दा_लामो = l।
    जवाफ = i।
  }
  i = i + 1।
}
// छापिन्छ: सङ्ख्या, अनि उसको शृङ्खलामा कति कदम
भनौँ(जवाफ, सबैभन्दा_लामो)।
