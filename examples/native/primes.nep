// १००० भन्दा सानो अभाज्य सङ्ख्या कति छन्? (count of primes below 1000)

काम अभाज्य(n) {
  यदि n < 2 {
    पठाउँ 0।
  }
  राखौँ d = 2।
  भएसम्म d * d <= n {
    यदि n % d == 0 {
      पठाउँ 0।
    }
    d = d + 1।
  }
  पठाउँ 1।
}

राखौँ गन्ती = 0।
राखौँ k = 1।
भएसम्म k < 1000 {
  गन्ती = गन्ती + अभाज्य(k)।
  k = k + 1।
}
भनौँ(गन्ती)।
