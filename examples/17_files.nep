// १७ — फाइल (Files)
//
//   ओएस_लेख्नुहोस्(बाटो, पाठ)  — फाइलमा लेख्छ (पुरानो सामग्री मेटिन्छ)
//   ओएस_पढ्नुहोस्(बाटो)        — फाइलको सामग्री शब्दका रूपमा फर्काउँछ
//   ओएस_सूची(फोल्डर)          — फोल्डरभित्रका नामहरूको सूची (क्रमबद्ध)
//
// यो उदाहरणले /tmp मा आफ्नै फोल्डर बनाउँछ र अन्त्यमा आफैँ मेटाउँछ।

राखौँ फोल्डर = "/tmp/नेपाली_उदाहरण_१७"।
आदेश_चलाउनुहोस्("mkdir", ["-p", फोल्डर])।

// लेख्ने र पढ्ने — देवनागरी सामग्री पनि ठीक चल्छ
राखौँ बाटो = फोल्डर + "/नमस्ते.txt"।
ओएस_लेख्नुहोस्(बाटो, "नमस्ते फाइल!\nदोस्रो पङ्क्ति")।
राखौँ सामग्री = ओएस_पढ्नुहोस्(बाटो)।
भनौँ(सामग्री)।
भनौँ("अक्षर सङ्ख्या:", लम्बाइ(सामग्री))।

// फेरि लेख्दा पुरानो सामग्री बदलिन्छ
ओएस_लेख्नुहोस्(बाटो, "नयाँ सामग्री")।
भनौँ(ओएस_पढ्नुहोस्(बाटो))।

// अर्को फाइल बनाएर फोल्डरको सूची हेर्ने
ओएस_लेख्नुहोस्(फोल्डर + "/a.txt", "क")।
ओएस_लेख्नुहोस्(फोल्डर + "/b.txt", "ख")।
भनौँ(ओएस_सूची(फोल्डर))।

// सूचीका हरेक फाइल पढ्ने
राखौँ नामहरू = ओएस_सूची(फोल्डर)।
राखौँ i = 0।
भएसम्म i < लम्बाइ(नामहरू) {
  भनौँ(नामहरू[i], "->", ओएस_पढ्नुहोस्(फोल्डर + "/" + नामहरू[i]))।
  i = i + 1।
}

// सफा गर्ने: बनाएका फोल्डर मेटाउने (आफ्नै फोल्डर मात्र!)
आदेश_चलाउनुहोस्("rm", ["-r", फोल्डर])।
भनौँ("सफा गरियो")।
