// C02: तुलना (comparisons)
//
// == != < > <= >=  ले सहि वा गलत दिन्छ। तुलनाको नतिजा आफैँ एउटा मान हो।

// सङ्ख्या
भनौँ("सङ्ख्या:", 5 == 5, 5 != 5, 5 < 7, 5 > 7, 5 <= 5, 5 >= 6)।

// देवनागरी र ASCII अङ्क उही सङ्ख्या हुन्
भनौँ("अङ्क:", १० == 10, ०.५ == 0.5)।

// एउटै प्रकारका मान
भनौँ("पाठ:", "नेपाल" == "नेपाल", "नेपाल" != "भारत", "क" == "ख")।
भनौँ("सहि/गलत:", सहि == सहि, सहि == गलत)।
भनौँ("केहीछैन:", केहीछैन == केहीछैन)।

// फरक प्रकार कहिल्यै बराबर हुँदैन (कुनै त्रुटि आउँदैन)
भनौँ("फरक प्रकार:", 1 == "1", सहि == 1, केहीछैन == 0, केहीछैन == "", केहीछैन == गलत)।

// सूचीको तुलना: तत्त्व-तत्त्व गरेर (क्रम पनि मिल्नुपर्छ)
भनौँ("सूची:", [1, 2] == [1, 2], [1, 2] == [2, 1], [] == [], [1] == [1, 2])।

// तुलनाको नतिजालाई चरमा राख्न मिल्छ
राखौँ ठूलो = 9 > 3।
भनौँ("नतिजा चर:", ठूलो, ठूलो == सहि)।

// तुलना जोडेर: दुवै तर्फ जाँच्न "र" प्रयोग गर्नुहोस्
राखौँ उमेर = 25।
भनौँ("१८ र ६० बीच?", उमेर >= 18 र उमेर <= 60)।

// नोट: पाठमा < > <= >= चल्दैन (त्रुटि E04 हेर्नुहोस्); पाठ केवल == र != ले तुलना गर्छ।
