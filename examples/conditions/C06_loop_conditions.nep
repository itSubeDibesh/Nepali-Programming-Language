// C06: लुपका सर्त (conditions that drive loops)
//
// भएसम्म को सर्त हरेक पटक, खण्ड चल्नुअघि, जाँचिन्छ।

// १. सर्त सुरुमै गलत भए एक पटक पनि चल्दैन
राखौँ i = 0।
भएसम्म गलत {
  i = 99।
}
भनौँ("१. कहिल्यै नचल्ने लुप:", i)।

// २. ठीक एक पटक चल्ने
राखौँ गन्ती = 0।
राखौँ एक_पटक = सहि।
भएसम्म एक_पटक {
  गन्ती = गन्ती + 1।
  एक_पटक = गलत।
}
भनौँ("२. एक पटक चल्यो:", गन्ती)।

// ३. जोडिएको सर्त: दुवै सहि रहुन्जेल
राखौँ क = 0।
भएसम्म क < 10 र क != 4 {
  क = क + 1।
}
भनौँ("३. ४ मा रोकियो:", क)।

// ४. "वा" सर्त: कुनै एक सहि रहुन्जेल
राखौँ ख = 0।
राखौँ ग = 0।
भएसम्म ख < 3 वा ग < 2 {
  ख = ख + 1।
  ग = ग + 1।
}
भनौँ("४. ख, ग:", ख, ग)।

// ५. झन्डी (flag) ले चाँडै निस्कने - "break" छैन
राखौँ सूची = [3, 8, 12, 5, 20]।
राखौँ अनुक्रम = 0।
राखौँ भेटियो = गलत।
भएसम्म अनुक्रम < लम्बाइ(सूची) र होइन भेटियो {
  यदि सूची[अनुक्रम] > 10 {
    भेटियो = सहि।
  } नत्र {
    अनुक्रम = अनुक्रम + 1।
  }
}
भनौँ("५. १० भन्दा ठूलो पहिलो तत्त्व यो अनुक्रममा:", अनुक्रम, "मान:", सूची[अनुक्रम])।

// ६. लुप भित्र सर्त: जोर र बिजोर गन्ने
राखौँ जोर = 0।
राखौँ बिजोर = 0।
राखौँ n = 1।
भएसम्म n <= 10 {
  यदि n % 2 == 0 {
    जोर = जोर + 1।
  } नत्र {
    बिजोर = बिजोर + 1।
  }
  n = n + 1।
}
भनौँ("६. १ देखि १० मा जोर, बिजोर:", जोर, बिजोर)।

// ७. कार्य भित्रको लुपबाट पठाउँले सिधै निस्कन्छ
काम पहिलो_बिजोर(सूची) {
  राखौँ i = 0।
  भएसम्म i < लम्बाइ(सूची) {
    यदि सूची[i] % 2 == 1 {
      पठाउँ सूची[i]।
    }
    i = i + 1।
  }
  पठाउँ केहीछैन।
}
भनौँ("७.", पहिलो_बिजोर([2, 4, 7, 9]), पहिलो_बिजोर([2, 4]))।

// ८. कार्यको नतिजा नै सर्त: कोल्याट्ज जस्तो सर्तमा टुङ्गिने लुप
राखौँ अङ्क = 27।
राखौँ कदम = 0।
भएसम्म अङ्क != 1 {
  यदि अङ्क % 2 == 0 {
    अङ्क = अङ्क / 2।
  } नत्र {
    अङ्क = 3 * अङ्क + 1।
  }
  कदम = कदम + 1।
}
भनौँ("८. २७ बाट १ सम्म कदम:", कदम)।
