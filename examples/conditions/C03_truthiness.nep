// C03: के सहि मानिन्छ? (truthiness)
//
// यदि / भएसम्म / र / वा / होइन ले सहि-गलत नभएका मान पनि जाँच्न सक्छन्:
//   गलत हुने:  0, "" (खाली पाठ), [] (खाली सूची), केहीछैन, गलत
//   सहि हुने:  बाँकी सबै (शून्य बाहेकका सङ्ख्या, खाली नभएको पाठ/सूची, कार्य, सहि)

काम जाँच(मान) {
  यदि मान {
    पठाउँ "सहि"।
  }
  पठाउँ "गलत"।
}

काम खाली() {
}

भनौँ("सङ्ख्या:")।
भनौँ("  0    ->", जाँच(0))।
भनौँ("  1    ->", जाँच(1))।
भनौँ("  -1   ->", जाँच(0 - 1))।
भनौँ("  0.5  ->", जाँच(0.5))।

भनौँ("पाठ:")।
भनौँ("  \"\"   ->", जाँच(""))।
भनौँ("  क    ->", जाँच("क"))।
भनौँ("  \"0\"  ->", जाँच("0"))।

भनौँ("सूची:")।
भनौँ("  []   ->", जाँच([]))।
भनौँ("  [0]  ->", जाँच([0]))।

भनौँ("अरू:")।
भनौँ("  केहीछैन ->", जाँच(केहीछैन))।
भनौँ("  सहि     ->", जाँच(सहि))।
भनौँ("  गलत     ->", जाँच(गलत))।
भनौँ("  कार्य   ->", जाँच(खाली))।

// होइन ले पनि उही नियम प्रयोग गर्छ
भनौँ("होइन:", होइन 0, होइन 5, होइन "", होइन [1])।

// सामान्य प्रयोग: "केही छ कि छैन" जाँच्ने
राखौँ नाम = ""।
यदि नाम {
  भनौँ("नाम:", नाम)।
} नत्र {
  भनौँ("नाम दिइएको छैन")।
}
