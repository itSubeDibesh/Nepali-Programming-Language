// C05: सर्ट-सर्किट (short-circuit)
//
// "र" मा बायाँ गलत भए, "वा" मा बायाँ सहि भए, दायाँ पक्ष चलाइँदै चलाइँदैन।
// यही कारण सुरक्षित जाँच (guard) लेख्न सकिन्छ।

// दायाँ पक्ष चल्यो कि चलेन: कार्यले छाप्छ भने देखिन्छ
काम बोल(नाम, मान) {
  भनौँ("    चल्यो:", नाम)।
  पठाउँ मान।
}

भनौँ("१. गलत र ...  (दायाँ नचल्ने)")।
राखौँ एक = बोल("क", गलत) र बोल("ख", सहि)।
भनौँ("  नतिजा:", एक)।

भनौँ("२. सहि वा ...  (दायाँ नचल्ने)")।
राखौँ दुई = बोल("ग", सहि) वा बोल("घ", सहि)।
भनौँ("  नतिजा:", दुई)।

भनौँ("३. सहि र ...  (दुवै चल्ने)")।
राखौँ तीन = बोल("ङ", सहि) र बोल("च", सहि)।
भनौँ("  नतिजा:", तीन)।

भनौँ("४. गलत वा ...  (दुवै चल्ने)")।
राखौँ चार = बोल("छ", गलत) वा बोल("ज", सहि)।
भनौँ("  नतिजा:", चार)।

// सुरक्षित जाँच १: खाली सूचीको पहिलो तत्त्व पढ्दा त्रुटि आउँथ्यो
राखौँ सूची = []।
यदि लम्बाइ(सूची) > 0 र सूची[0] == 5 {
  भनौँ("पहिलो तत्त्व ५ हो")।
} नत्र {
  भनौँ("सुरक्षित जाँच: सूची खाली छ, सूची[0] पढिएन")।
}

// सुरक्षित जाँच २: "वा" सँग
यदि लम्बाइ(सूची) == 0 वा सूची[0] == 5 {
  भनौँ("खाली छ वा पहिलो ५ छ")।
}

// सुरक्षित जाँच ३: शून्यले भाग नगर्न
राखौँ भाजक = 0।
यदि भाजक != 0 र 10 / भाजक > 2 {
  भनौँ("१० / भाजक > २")।
} नत्र {
  भनौँ("भाजक शून्य छ, भाग गरिएन")।
}

// जाँच सहि भएपछि मात्र पढ्ने: लम्बाइ > 2 भएकाले बिना_जाँच[2] सुरक्षित छ
राखौँ बिना_जाँच = [1, 2, 3]।
यदि लम्बाइ(बिना_जाँच) > 2 र बिना_जाँच[2] == 3 {
  भनौँ("तेस्रो तत्त्व ३ हो")।
}
