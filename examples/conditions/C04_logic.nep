// C04: र / वा / होइन (and / or / not)

// सत्यता तालिका
भनौँ("र:")।
भनौँ("  सहि र सहि  =", सहि र सहि)।
भनौँ("  सहि र गलत  =", सहि र गलत)।
भनौँ("  गलत र सहि  =", गलत र सहि)।
भनौँ("  गलत र गलत  =", गलत र गलत)।

भनौँ("वा:")।
भनौँ("  सहि वा सहि  =", सहि वा सहि)।
भनौँ("  सहि वा गलत  =", सहि वा गलत)।
भनौँ("  गलत वा सहि  =", गलत वा सहि)।
भनौँ("  गलत वा गलत  =", गलत वा गलत)।

भनौँ("होइन:")।
भनौँ("  होइन सहि =", होइन सहि)।
भनौँ("  होइन गलत =", होइन गलत)।

// नतिजा सधैँ सहि वा गलत हुन्छ (JavaScript जस्तो बायाँ/दायाँ मान होइन)
भनौँ("नतिजा प्रकार:", 3 र 4, 0 वा 7, "" वा "क", केहीछैन वा 0)।

// प्राथमिकता: होइन > र > वा
भनौँ("प्राथमिकता:")।
भनौँ("  सहि वा गलत र गलत    =", सहि वा गलत र गलत)।
भनौँ("  (सहि वा गलत) र गलत  =", (सहि वा गलत) र गलत)।
भनौँ("  होइन सहि र गलत       =", होइन सहि र गलत)।
भनौँ("  होइन (सहि र गलत)     =", होइन (सहि र गलत))।

// तुलनासँग: तुलना पहिले, अनि र / वा
भनौँ("  2 > 1 र 3 > 2 वा गलत =", 2 > 1 र 3 > 2 वा गलत)।

// व्यावहारिक: लीप वर्ष (४ ले भाग जाने, तर १०० ले होइन, ४०० ले भए हुन्छ)
काम लीप(वर्ष) {
  पठाउँ (वर्ष % 4 == 0 र वर्ष % 100 != 0) वा वर्ष % 400 == 0।
}
भनौँ("लीप वर्ष:", लीप(2024), लीप(1900), लीप(2000), लीप(2023))।
