// C07: सङ्ख्याका किनारा अवस्था (number edge cases)
//
// सबै सङ्ख्या दशमलव (f64) हुन्, त्यसैले केही नतिजा अरू भाषामा जस्तै अचम्मका हुन्छन्।

// शून्यले भाग गर्दा त्रुटि आउँदैन: अनन्त (inf) र NaN
भनौँ("१ / 0 =", 1 / 0)।
भनौँ("(0-1) / 0 =", (0 - 1) / 0)।
भनौँ("0 / 0 =", 0 / 0)।
भनौँ("5 % 0 =", 5 % 0)।

// NaN आफ्नै बराबर पनि हुँदैन
राखौँ न = 0 / 0।
भनौँ("NaN:", न == न, न != न, न < 1, न > 1)।

// अनन्तसँग तुलना
राखौँ अन = 1 / 0।
भनौँ("अनन्त:", अन > 1000000, अन == अन, (0 - अन) < 0)।

// दशमलवको सटीकता: सर्तमा == प्रयोग गर्दा सावधान
भनौँ("०.१ + ०.२ =", 0.1 + 0.2)।
भनौँ("०.१ + ०.२ == ०.३ ?", 0.1 + 0.2 == 0.3)।
// सुरक्षित तरिका: धेरै सानो फरक भन्दा कम भए बराबर मान्ने
राखौँ फरक = 0.1 + 0.2 - 0.3।
यदि फरक < 0.000001 र फरक > 0 - 0.000001 {
  भनौँ("लगभग बराबर छन्")।
}

// पूर्ण सङ्ख्या दशमलव बिना छापिन्छ
भनौँ("पूर्ण:", 6 / 2, 7 / 2, 2 * 0.5)।

// शेषफल (%): ऋणात्मकमा चिन्ह बायाँ सङ्ख्याको हुन्छ
भनौँ("शेषफल:", 7 % 3, (0 - 7) % 3, 7 % (0 - 3), 6 % 3)।

// भाग जाने कि नजाने: % को नतिजा शून्यसँग तुलना गर्ने
राखौँ n2 = 10।
यदि n2 % 2 == 0 र n2 % 5 == 0 {
  भनौँ("१० ले २ र ५ दुवैले भाग जान्छ")।
}
