// C01: यदि / नत्र यदि / नत्र - सर्तका सबै रूप (every form of if / else)

// १. एक्लो यदि: सर्त सहि भए मात्र खण्ड चल्छ
राखौँ तापक्रम = 32।
यदि तापक्रम > 30 {
  भनौँ("१. गर्मी छ")।
}
यदि तापक्रम > 40 {
  भनौँ("यो कहिल्यै छापिँदैन")।
}

// २. यदि / नत्र: ठीक एउटा खण्ड चल्छ
यदि तापक्रम > 40 {
  भनौँ("धेरै गर्मी")।
} नत्र {
  भनौँ("२. सहनीय")।
}

// ३. नत्र यदि शृङ्खला: माथिबाट हेर्दै पहिलो मिल्ने खण्ड मात्र चल्छ
काम ग्रेड(अंक) {
  यदि अंक >= 90 {
    पठाउँ "ए"।
  } नत्र यदि अंक >= 80 {
    पठाउँ "बी"।
  } नत्र यदि अंक >= 70 {
    पठाउँ "सी"।
  } नत्र यदि अंक >= 60 {
    पठाउँ "डी"।
  } नत्र {
    पठाउँ "एफ"।
  }
}
भनौँ("३.", ग्रेड(95), ग्रेड(85), ग्रेड(75), ग्रेड(65), ग्रेड(10))।

// सीमा मान: ठीक ९० र ८९ (>= ले ९० समावेश गर्छ)
भनौँ("सीमा:", ग्रेड(90), ग्रेड(89), ग्रेड(60), ग्रेड(59))।

// ४. सर्त भित्र सर्त
राखौँ क = 1।
राखौँ ख = 2।
यदि क == 1 {
  यदि ख == 2 {
    भनौँ("४. दुवै मिल्यो")।
  } नत्र {
    भनौँ("४. क मात्र")।
  }
} नत्र {
  भनौँ("४. क मिलेन")।
}

// ५. "भए" (then) ऐच्छिक छ
यदि क == 1 भए {
  भनौँ("५. भए सहित")।
}

// ६. खाली खण्ड ठीक छ, केही हुँदैन
यदि सहि {
}
यदि गलत {
  भनौँ("कहिल्यै छापिँदैन")।
}
भनौँ("६. खाली खण्डपछि पनि चल्यो")।

// ७. सर्तबाट चाँडै फर्कने (early return)
काम चिन्ह(n) {
  यदि n > 0 {
    पठाउँ "धनात्मक"।
  }
  यदि n < 0 {
    पठाउँ "ऋणात्मक"।
  }
  पठाउँ "शून्य"।
}
भनौँ("७.", चिन्ह(5), चिन्ह(0 - 5), चिन्ह(0))।

// ८. सर्तको खण्डमा चर: राखौँ ले नयाँ (लुकाउने) चर बनाउँछ, "=" ले बाहिरकै फेर्छ
राखौँ x = 1।
यदि सहि {
  राखौँ x = 2।
  भनौँ("८. भित्र नयाँ x:", x)।
}
भनौँ("८. बाहिर x:", x)।
यदि सहि {
  x = 3।
}
भनौँ("८. बाहिरको x फेरियो:", x)।
