// ११ — क्लोजर (Closures)
//
// कामभित्र काम बनाउन सकिन्छ, र भित्री कामले बाहिरी कामका चरहरू
// "सम्झिन्छ" — बाहिरी काम सकिएपछि पनि। यसैलाई क्लोजर भनिन्छ।

// एउटा "जोड्ने मेसिन बनाउने" काम
काम जोड्ने_बनाऊ(थप) {
  काम जोड(न) {
    पठाउँ न + थप।       // `थप` बाहिरी कामको चर हो
  }
  पठाउँ जोड।             // काम आफैँलाई फर्काउने (कोष्ठक बिना)
}

राखौँ पाँच_थप = जोड्ने_बनाऊ(5)।
राखौँ दश_थप = जोड्ने_बनाऊ(10)।
भनौँ(पाँच_थप(1), दश_थप(1))।     // दुई क्लोजर, आ-आफ्नो `थप` सहित

// फर्काएको कामलाई सिधै बोलाउन पनि मिल्छ
भनौँ(जोड्ने_बनाऊ(100)(1))।

// क्लोजरले बाहिरको चर "परिवर्तन" पनि गर्न सक्छ → गन्तीकर्ता (counter)
काम गन्तीकर्ता_बनाऊ() {
  राखौँ अहिले = 0।
  काम अर्को() {
    अहिले = अहिले + 1।
    पठाउँ अहिले।
  }
  पठाउँ अर्को।
}

राखौँ क = गन्तीकर्ता_बनाऊ()।
राखौँ ख = गन्तीकर्ता_बनाऊ()।
भनौँ(क(), क(), क())।             // क को आफ्नै गन्ती
भनौँ(ख())।                       // ख को गन्ती अलग छ

// कामलाई आर्गुमेन्टका रूपमा दिने: सूचीको हरेक तत्वमा काम लगाउने
काम प्रत्येकमा_लगाऊ(सूची, फ) {
  राखौँ नयाँ = []।
  राखौँ i = 0।
  भएसम्म i < लम्बाइ(सूची) {
    थप्नुहोस्(नयाँ, फ(सूची[i]))।
    i = i + 1।
  }
  पठाउँ नयाँ।
}

काम वर्ग(न) {
  पठाउँ न * न।
}
भनौँ(प्रत्येकमा_लगाऊ([1, 2, 3, 4], वर्ग))।
भनौँ(प्रत्येकमा_लगाऊ([1, 2, 3, 4], पाँच_थप))।   // क्लोजर पनि आर्गुमेन्ट बन्छ
