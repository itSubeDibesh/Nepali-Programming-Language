// २० — अन्य भाषासँग मिलेर (Python / JavaScript / TypeScript)
//
// नेपालीभित्रै अर्को भाषाको साँचो इन्जिन जोडिएको छ (सबप्रोसेस होइन):
//   पाइथन_चलाउनुहोस्(कोड)  — CPython; कोडले `परिणाम` नामको चरमा उत्तर राख्नुपर्छ
//   जेएस_चलाउनुहोस्(कोड)   — QuickJS; अन्तिम अभिव्यक्तिको मान फर्कन्छ
//   टिएस_चलाउनुहोस्(कोड)   — TypeScript लाई पहिले JS बनाइन्छ, त्यसपछि उही इन्जिनमा चल्छ
//
// नतिजा सङ्ख्या/शब्द/सहि-गलत/सूचीमा स्वतः बदलिन्छ (शब्दकोश/object होइन)।

// --- Python ---
भनौँ(पाइथन_चलाउनुहोस्("import math\nपरिणाम = math.sqrt(144)"))।

// धेरै पङ्क्तिको साँचो Python: फङ्सन, लुप, सूची
राखौँ पाइथन_कोड = "
def वर्गहरू(n):
    return [i * i for i in range(1, n + 1)]

परिणाम = वर्गहरू(5)
"।
भनौँ(पाइथन_चलाउनुहोस्(पाइथन_कोड))।

// --- JavaScript ---
भनौँ(जेएस_चलाउनुहोस्("[1, 2, 3, 4].map(x => x * 10).length + 1"))।
भनौँ(जेएस_चलाउनुहोस्("'नमस्ते'.toUpperCase() + ' ' + 'संसार'"))।

// --- TypeScript (प्रकार सहित) ---
राखौँ टिएस_कोड = "
interface बिन्दु { x: number; y: number }
function दूरी(क: बिन्दु, ख: बिन्दु): number {
  const dx: number = क.x - ख.x;
  const dy: number = क.y - ख.y;
  return dx * dx + dy * dy;
}
दूरी({ x: 0, y: 0 }, { x: 3, y: 4 })
"।
भनौँ("दूरीको वर्ग:", टिएस_चलाउनुहोस्(टिएस_कोड))।

// नतिजा नेपालीको चरमा राखेर आफ्नै कोडमा प्रयोग गर्न सकिन्छ
राखौँ योग = पाइथन_चलाउनुहोस्("परिणाम = sum(range(1, 101))")।
भनौँ("१ देखि १०० को जोड:", योग, " → दोब्बर:", योग * 2)।
