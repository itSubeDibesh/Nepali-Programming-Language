// ०९ — शब्द (Strings)
//
// शब्दहरू यूनिकोड अक्षर (character) गनेर चल्छन् — देवनागरीमा एउटा
// "अक्षर" भनेको एउटा यूनिकोड कोड-प्वाइन्ट हो (मात्रा, हलन्त सहित छुट्टाछुट्टै)।

राखौँ शब्द = "नेपाल"।

// `लम्बाइ` — कति वटा यूनिकोड अक्षर
भनौँ(शब्द, "मा", लम्बाइ(शब्द), "वटा कोड-प्वाइन्ट छन्")।
भनौँ("नमस्ते", लम्बाइ("नमस्ते"))।      // न, म, स, ्(हलन्त), त, े(मात्रा) → ६

// `अक्षर(शब्द, स्थान)` — त्यो स्थानको एउटा अक्षर (० बाट सुरु)
भनौँ(अक्षर(शब्द, 0), अक्षर(शब्द, 1), अक्षर(शब्द, 2), अक्षर(शब्द, 3))।

// `संकेत(अक्षर)` — त्यो अक्षरको यूनिकोड कोड-प्वाइन्ट (सङ्ख्या)
भनौँ(संकेत("A"), संकेत("a"), संकेत("न"))।    // 'न' = U+0928 = २३४४

// जोड्ने: `+`
राखौँ पूरा = "नमस्ते " + शब्द + "!"।
भनौँ(पूरा)।

// शब्दलाई अक्षर-अक्षर गरी पढेर उल्टाउने
काम उल्टाउ(श) {
  राखौँ नतिजा = ""।
  राखौँ i = लम्बाइ(श) - 1।
  भएसम्म i >= 0 {
    नतिजा = नतिजा + अक्षर(श, i)।
    i = i - 1।
  }
  पठाउँ नतिजा।
}
// ध्यान दिनुहोस्: देवनागरीमा कोड-प्वाइन्ट उल्टाउँदा मात्रा/चन्द्रबिन्दु
// अक्षरभन्दा अघि सर्छन्, त्यसैले दोस्रो नतिजा "राम्रो" नदेखिन सक्छ।
भनौँ(उल्टाउ("abcde"), उल्टाउ("काठमाडौँ"))।

// एउटा अक्षर कति पटक आएको छ भनेर गन्ने
काम गन्ती(श, खोज) {
  राखौँ जम्मा = 0।
  राखौँ i = 0।
  भएसम्म i < लम्बाइ(श) {
    यदि अक्षर(श, i) == खोज {
      जम्मा = जम्मा + 1।
    }
    i = i + 1।
  }
  पठाउँ जम्मा।
}
भनौँ("'a' कति पटक:", गन्ती("banana", "a"))।

// पालिन्ड्रोम (उल्टाउँदा पनि उही) — जस्तै "नमन"
काम पालिन्ड्रोम(श) {
  पठाउँ श == उल्टाउ(श)।
}
भनौँ(पालिन्ड्रोम("नमन"), पालिन्ड्रोम("नेपाल"))।

// शब्दलाई सङ्ख्यासँग जोड्न पनि मिल्छ
भनौँ("नम्बर " + 7 + " मा स्वागत छ")।
