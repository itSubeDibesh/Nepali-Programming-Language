// १४ — क्रमबद्ध गर्ने (Sorting): बबल सोर्ट
//
// छेउछाउका दुई तत्व तुलना गर्ने, गलत क्रममा भए साट्ने। यसो गर्दै जाँदा
// हरेक चरणमा सबैभन्दा ठूलो तत्व अन्त्यतिर पुग्छ।

काम बबल_सोर्ट(सूची) {
  राखौँ n = लम्बाइ(सूची)।
  राखौँ चरण = 0।
  भएसम्म चरण < n - 1 {
    राखौँ j = 0।
    भएसम्म j < n - 1 - चरण {
      यदि सूची[j] > सूची[j + 1] {
        // दुई तत्व साट्ने — अस्थायी चर चाहिन्छ
        राखौँ अस्थायी = सूची[j]।
        सूची[j] = सूची[j + 1]।
        सूची[j + 1] = अस्थायी।
      }
      j = j + 1।
    }
    चरण = चरण + 1।
  }
  पठाउँ सूची।
}

राखौँ सङ्ख्याहरू = [64, 34, 25, 12, 22, 11, 90]।
भनौँ("अघि :", सङ्ख्याहरू)।
बबल_सोर्ट(सङ्ख्याहरू)।             // सूची सन्दर्भ भएकाले सोही सूची नै मिलाइन्छ
भनौँ("पछि :", सङ्ख्याहरू)।

// दोहोरिएका र ऋणात्मक सङ्ख्या पनि चल्छ
भनौँ(बबल_सोर्ट([3, -1, 3, 0, -5, 2]))।

// खाली र एक तत्व भएको सूची पनि ठिकै छ
भनौँ(बबल_सोर्ट([]), बबल_सोर्ट([42]))।

// उल्टो क्रम (ठूलोबाट सानो) चाहिए तुलना उल्टाउनुहोस्: `<` लाई `>` को ठाउँमा।
