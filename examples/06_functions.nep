// ०६ — कार्य (Functions)
//
// `काम नाम(पैरामिटर...) { ... }` ले काम (function) बनाउँछ।
// `पठाउँ मान` ले मान फर्काउँछ र कामलाई त्यहीँ टुङ्ग्याउँछ।

काम नमस्कार(नाम) {
  भनौँ("नमस्कार,", नाम + "!")।
}
नमस्कार("रमेश")।
नमस्कार("गीता")।

// दुई पैरामिटर, र एउटा फर्काइएको मान
काम जोड(क, ख) {
  पठाउँ क + ख।
}
राखौँ नतिजा = जोड(40, 2)।
भनौँ("जोड:", नतिजा)।

// कामको नतिजा सिधै अर्को कामलाई दिन सकिन्छ
भनौँ(जोड(जोड(1, 2), जोड(3, 4)))।

// एउटा कामले अर्को काम बोलाउन सक्छ
काम वर्ग(न) {
  पठाउँ न * न।
}
काम कर्ण(क, ख) {
  // पाइथागोरस: कर्ण² = क² + ख²  (यहाँ वर्गमूल छैन, त्यसैले वर्ग नै फर्काउँछौँ)
  पठाउँ वर्ग(क) + वर्ग(ख)।
}
भनौँ("३-४ को कर्ण वर्ग:", कर्ण(3, 4))।

// दुईमध्ये ठूलो
काम ठूलो(क, ख) {
  यदि क > ख {
    पठाउँ क।
  }
  पठाउँ ख।
}
भनौँ(ठूलो(7, 12), ठूलो(9, 3))।

// `पठाउँ` नभएको काम केहीछैन (null) फर्काउँछ
काम केही_गर्दैन() {
}
भनौँ(केही_गर्दैन())।

// कामलाई चरमा राख्न र अर्को कामको आर्गुमेन्ट बनाउन पनि सकिन्छ
काम दुई_पटक(फ, मान) {
  पठाउँ फ(फ(मान))।
}
काम दोब्बर(न) {
  पठाउँ न * 2।
}
भनौँ(दुई_पटक(दोब्बर, 5))।     // दोब्बर(दोब्बर(५)) = २०
