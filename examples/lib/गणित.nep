// गणित.nep — १६_modules.nep ले आयात गर्ने सहायक फाइल
//
// आयात गरिएको फाइलका सबै कामहरू आयात गर्ने फाइलमा प्रयोग गर्न मिल्छ।
// यस्ता फाइलमा सामान्यतया काम मात्र परिभाषित गरिन्छ (कुनै कुरा छाप्दैन),
// किनकि आयात हुँदा माथिल्ला वाक्यहरू पनि चल्छन्।

काम वर्ग(न) {
  पठाउँ न * न।
}

काम घन(न) {
  पठाउँ न * न * न।
}

काम औसत(सूची) {
  राखौँ जोड = 0।
  राखौँ i = 0।
  भएसम्म i < लम्बाइ(सूची) {
    जोड = जोड + सूची[i]।
    i = i + 1।
  }
  पठाउँ जोड / लम्बाइ(सूची)।
}
