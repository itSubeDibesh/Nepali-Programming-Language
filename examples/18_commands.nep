// १८ — आदेश (Commands)
//
// `आदेश_चलाउनुहोस्(कार्यक्रम, [आर्गुमेन्टहरू])` ले साँचो Linux/macOS कार्यक्रम
// चलाउँछ र तीन तत्वको सूची फर्काउँछ:
//     [निकास_कोड, stdout, stderr]
//
// आर्गुमेन्टहरू सधैँ सूचीमा दिनुपर्छ। कार्यक्रम सिधै चल्छ, `sh -c` मार्फत होइन —
// त्यसैले आर्गुमेन्टभित्र `;` वा `$(...)` जस्ता कुरा केवल पाठ हुन्, आदेश होइनन्।

राखौँ नतिजा = आदेश_चलाउनुहोस्("echo", ["नमस्ते", "आदेशबाट"])।
भनौँ("निकास कोड:", नतिजा[0])।         // ० = सफल
भनौँ("stdout    :", नतिजा[1])।         // echo ले अन्त्यमा नयाँ पङ्क्ति थप्छ
भनौँ("stderr लम्बाइ:", लम्बाइ(नतिजा[2]))।

// असफल हुने कार्यक्रमको निकास कोड शून्य हुँदैन
भनौँ("false को निकास कोड:", आदेश_चलाउनुहोस्("false", [])[0])।

// stdout र stderr छुट्टै आउँछन्। यहाँ `sh` लाई हामीले नै "कार्यक्रम" बनाएका छौँ।
राखौँ मिश्रित = आदेश_चलाउनुहोस्("sh", ["-c", "echo सामान्य; echo त्रुटि 1>&2; exit 3"])।
भनौँ("कोड:", मिश्रित[0])।
भनौँ("stdout:", मिश्रित[1])।
भनौँ("stderr:", मिश्रित[2])।

// सुरक्षा: शेल चिन्हहरू सामान्य पाठ बन्छन्, चल्दैनन्।
भनौँ(आदेश_चलाउनुहोस्("echo", ["$(echo हानि); echo दोस्रो"])[1])।

// नतिजा प्रयोग गरेर निर्णय लिने
राखौँ जाँच = आदेश_चलाउनुहोस्("test", ["-d", "/tmp"])।
यदि जाँच[0] == 0 {
  भनौँ("/tmp फोल्डर छ")।
}
