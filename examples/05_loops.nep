// ०५ — लुप (Loops): भएसम्म
//
// `भएसम्म सर्त { ... }` — सर्त सहि रहुन्जेल भित्रको काम दोहोरिन्छ।
// (यो भाषामा `for` र `break` छैन; सबै दोहोरिने काम `भएसम्म` ले हुन्छ।)

// १ देखि ५ सम्म गन्ती
राखौँ i = 1।
भएसम्म i <= 5 {
  भनौँ("गन्ती:", i)।
  i = i + 1।         // यो लाइन नलेखे लुप कहिल्यै टुङ्गिँदैन!
}

// १ देखि १० सम्मको जोड
राखौँ जोड = 0।
राखौँ n = 1।
भएसम्म n <= 10 {
  जोड = जोड + n।
  n = n + 1।
}
भनौँ("१ देखि १० सम्मको जोड =", जोड)।

// ३ को पहाडा (multiplication table)
राखौँ गुणक = 1।
भएसम्म गुणक <= 5 {
  भनौँ("३ x", गुणक, "=", 3 * गुणक)।
  गुणक = गुणक + 1।
}

// उल्टो गन्ती
राखौँ बाँकी = 3।
भएसम्म बाँकी > 0 {
  भनौँ(बाँकी + "...")।
  बाँकी = बाँकी - 1।
}
भनौँ("उड्यो!")।

// `break` नभएकाले बीचमै रोक्न झण्डा (flag) चर प्रयोग गरिन्छ।
// यहाँ: ७ ले भाग जाने पहिलो सङ्ख्या (१०० भन्दा माथि) खोज्ने।
राखौँ खोज = 100।
राखौँ भेटियो = गलत।
भएसम्म होइन भेटियो {
  यदि खोज % 7 == 0 {
    भेटियो = सहि।
  } नत्र {
    खोज = खोज + 1।
  }
}
भनौँ("१०० पछिको ७ को गुणित:", खोज)।
