// ०३ — अङ्कगणित (Arithmetic)

राखौँ क = 17।
राखौँ ख = 5।

भनौँ("जोड     :", क + ख)।
भनौँ("घटाउ    :", क - ख)।
भनौँ("गुणन    :", क * ख)।
भनौँ("भाग     :", क / ख)।      // भागफल दशमलवमा आउँछ
भनौँ("शेष     :", क % ख)।      // % ले भाग गरेपछि बाँकी (remainder) दिन्छ
भनौँ("ऋणात्मक :", -क)।

// सामान्य गणितको क्रम लागू हुन्छ: गुणन/भाग पहिले, जोड/घटाउ पछि।
भनौँ(2 + 3 * 4)।                // ३*४ पहिले → १४
भनौँ((2 + 3) * 4)।              // कोष्ठकले क्रम बदल्छ → २०
भनौँ(100 - 30 - 20)।            // बायाँबाट दायाँ → ५०

// दशमलव सङ्ख्या
भनौँ(7 / 2, 2.5 * 4, 0.5 + 0.25)।

// यहाँ छोटो सूत्र: वृत्तको क्षेत्रफल = π × r × r
राखौँ पाइ = 3.14159।
राखौँ त्रिज्या = 10।
भनौँ("क्षेत्रफल:", पाइ * त्रिज्या * त्रिज्या)।

// शेष (%) को उपयोग: जोर/बिजोर पत्ता लगाउन।
भनौँ(10 % 2, 11 % 2)।           // ० = जोर, १ = बिजोर
