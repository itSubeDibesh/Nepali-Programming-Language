// १३ — मूळ सङ्ख्या (Prime numbers)
//
// मूळ सङ्ख्या: १ र आफूबाहेक अरू कुनै सङ्ख्याले भाग नजाने (>१)।

काम हो_मूळ(न) {
  यदि न < 2 {
    पठाउँ गलत।
  }
  राखौँ भाजक = 2।
  // भाजक * भाजक <= न सम्म मात्र जाँच्दा पुग्छ
  भएसम्म भाजक * भाजक <= न {
    यदि न % भाजक == 0 {
      पठाउँ गलत।         // `पठाउँ` ले लुपबाट पनि सिधै बाहिर निकाल्छ
    }
    भाजक = भाजक + 1।
  }
  पठाउँ सहि।
}

भनौँ(हो_मूळ(1), हो_मूळ(2), हो_मूळ(15), हो_मूळ(17))।

// ३० सम्मका सबै मूळ सङ्ख्या सूचीमा जम्मा गर्ने
राखौँ मूळहरू = []।
राखौँ न = 1।
भएसम्म न <= 30 {
  यदि हो_मूळ(न) {
    थप्नुहोस्(मूळहरू, न)।
  }
  न = न + 1।
}
भनौँ("३० सम्मका मूळ सङ्ख्या:", मूळहरू)।
भनौँ("जम्मा", लम्बाइ(मूळहरू), "वटा")।
