// १५ — फिबोनाची (Fibonacci)
//
// ०, १, १, २, ३, ५, ८, १३, ... हरेक सङ्ख्या अघिल्ला दुईको जोड हो।

// तरिका १: पुनरावृत्ति — परिभाषासँग सिधै मिल्छ, तर ढिलो (सानो n का लागि ठीक)
काम फिबो_पुनः(n) {
  यदि n < 2 {
    पठाउँ n।
  }
  पठाउँ फिबो_पुनः(n - 1) + फिबो_पुनः(n - 2)।
}

// तरिका २: लुप — दुई चरमा अघिल्ला मान सम्हाल्ने, छिटो
काम फिबो_लुप(n) {
  राखौँ क = 0।
  राखौँ ख = 1।
  राखौँ i = 0।
  भएसम्म i < n {
    राखौँ अर्को = क + ख।
    क = ख।
    ख = अर्को।
    i = i + 1।
  }
  पठाउँ क।
}

// पहिलो १२ वटा पद सूचीमा
राखौँ श्रृङ्खला = []।
राखौँ i = 0।
भएसम्म i < 12 {
  थप्नुहोस्(श्रृङ्खला, फिबो_लुप(i))।
  i = i + 1।
}
भनौँ(श्रृङ्खला)।

// दुवै तरिकाले उही उत्तर आउँछ
भनौँ("फिबो(१५) पुनः:", फिबो_पुनः(15))।
भनौँ("फिबो(१५) लुप:", फिबो_लुप(15))।

// लुपको तरिकाले ठूला पद पनि तुरुन्तै
भनौँ("फिबो(५०) =", फिबो_लुप(50))।

// सुनौलो अनुपात: छेउछाउका पदको भागफल १.६१८... तिर जान्छ
भनौँ("फिबो(३०)/फिबो(२९) =", फिबो_लुप(30) / फिबो_लुप(29))।
