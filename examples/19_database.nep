// १९ — डाटाबेस (SQLite)
//
//   डाटाबेस_चलाउनुहोस्(sql)  — CREATE/INSERT/UPDATE/DELETE चलाउँछ, प्रभावित पङ्क्ति सङ्ख्या फर्काउँछ
//   डाटाबेस_सोध्नुहोस्(sql)   — SELECT चलाउँछ, पङ्क्तिहरूको सूची (सूचीको सूची) फर्काउँछ
//
// यो साँचो SQLite हो, फाइलमा स्थायी रूपमा बस्छ। फाइलको बाटो `NEPALI_DB` वातावरण
// चरले तोक्छ (नतोकिए ~/.nepali/os.db)। यो उदाहरणले सुरु र अन्त्यमा आफ्नो
// तालिका मेटाउँछ, ताकि जति पटक चलाए पनि उही नतिजा आओस्।

डाटाबेस_चलाउनुहोस्("DROP TABLE IF EXISTS उदाहरण_सामान")।
डाटाबेस_चलाउनुहोस्("CREATE TABLE उदाहरण_सामान (नाम TEXT, मूल्य INTEGER)")।

// INSERT ले कति पङ्क्ति थपियो भन्ने फर्काउँछ
भनौँ("थपियो:", डाटाबेस_चलाउनुहोस्("INSERT INTO उदाहरण_सामान VALUES ('चामल', 120)"))।
डाटाबेस_चलाउनुहोस्("INSERT INTO उदाहरण_सामान VALUES ('दाल', 200)")।
डाटाबेस_चलाउनुहोस्("INSERT INTO उदाहरण_सामान VALUES ('तेल', 350)")।

// SELECT को नतिजा सूचीको सूची हो: [[नाम, मूल्य], [नाम, मूल्य], ...]
राखौँ सबै = डाटाबेस_सोध्नुहोस्("SELECT नाम, मूल्य FROM उदाहरण_सामान ORDER BY मूल्य")।
भनौँ(सबै)।
भनौँ("पङ्क्ति सङ्ख्या:", लम्बाइ(सबै))।

// नतिजा लुपले पढ्ने
राखौँ i = 0।
भएसम्म i < लम्बाइ(सबै) {
  भनौँ(सबै[i][0], "को मूल्य रु.", सबै[i][1])।
  i = i + 1।
}

// SQL आफैँले हिसाब गर्न पनि सक्छ
भनौँ("जम्मा:", डाटाबेस_सोध्नुहोस्("SELECT SUM(मूल्य) FROM उदाहरण_सामान")[0][0])।

// UPDATE / DELETE
भनौँ("बदलियो:", डाटाबेस_चलाउनुहोस्("UPDATE उदाहरण_सामान SET मूल्य = मूल्य + 10 WHERE नाम = 'दाल'"))।
भनौँ(डाटाबेस_सोध्नुहोस्("SELECT मूल्य FROM उदाहरण_सामान WHERE नाम = 'दाल'")[0][0])।
भनौँ("मेटियो:", डाटाबेस_चलाउनुहोस्("DELETE FROM उदाहरण_सामान WHERE मूल्य > 300"))।
भनौँ(डाटाबेस_सोध्नुहोस्("SELECT नाम FROM उदाहरण_सामान ORDER BY नाम"))।

// सफा गर्ने
डाटाबेस_चलाउनुहोस्("DROP TABLE उदाहरण_सामान")।
