{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Nepali Studio",
  "version": "1.0.0",
  "identifier": "org.nepalilang.studio",
  "build": {
    "frontendDist": "../studio/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../studio run dev",
    "beforeBuildCommand": "NEXT_EXPORT=true npm --prefix ../studio run build"
  },
  "app": {
    "windows": [
      {
        "title": "नेपाली स्टुडियो (Nepali Studio)",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval' blob: data: https:; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "नेपाली प्रोग्रामिङ भाषा स्टुडियो IDE",
    "longDescription": "High-performance native IDE and runtime for the Nepali Programming Language.",
    "copyright": "© 2026 Nepali Programming Language Authors",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "fileAssociations": [
      {
        "ext": [
          "nep",
          "nepali",
          "नेपाली"
        ],
        "name": "Nepali Source Code",
        "description": "नेपाली स्रोत कोड",
        "role": "Editor"
      }
    ]
  }
}