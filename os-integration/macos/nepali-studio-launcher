#!/usr/bin/env bash
# ==============================================================================
# Standalone Native macOS Launcher for Nepali Studio Desktop IDE
# ==============================================================================
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$DIR/../.." && pwd)"
RESOURCES_DIR="$APP_DIR/Contents/Resources"
STUDIO_SERVER_DIR="$RESOURCES_DIR/studio"
TARGET_FILE="${1:-}"

PORT=8765

# Locate Node.js executable across standard macOS user & package paths
NODE_BIN=""
for p in \
  "$(command -v node 2>/dev/null)" \
  "$HOME/.local/share/tokless/node/bin/node" \
  "$HOME/.local/bin/node" \
  "$HOME/.local/share/fnm/current/bin/node" \
  "$HOME/.volta/bin/node" \
  "$HOME/.asdf/shims/node" \
  "$HOME/.local/share/mise/shims/node" \
  "$HOME/.nodenv/shims/node" \
  /opt/homebrew/bin/node \
  /usr/local/bin/node \
  "$HOME"/.nvm/versions/node/*/bin/node \
  /usr/bin/node; do
  if [ -n "$p" ] && [ -x "$p" ]; then
    NODE_BIN="$p"
    break
  fi
done

NODE_DIR="$(dirname "$NODE_BIN" 2>/dev/null)"
export PATH="$DIR:$NODE_DIR:$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
export NODE_ENV=production
export PORT=$PORT
export HOSTNAME=127.0.0.1

# Configure Bundled AI Model Paths if present
if [ -f "$RESOURCES_DIR/models/llm/model.gguf" ] && [ -f "$RESOURCES_DIR/models/llm/tokenizer.json" ]; then
  export NEPALI_AI_MODEL_PATH="$RESOURCES_DIR/models/llm/model.gguf"
  export NEPALI_AI_TOKENIZER_PATH="$RESOURCES_DIR/models/llm/tokenizer.json"
elif [ -f "$RESOURCES_DIR/models/llm-small/model.gguf" ] && [ -f "$RESOURCES_DIR/models/llm-small/tokenizer.json" ]; then
  export NEPALI_AI_MODEL_PATH="$RESOURCES_DIR/models/llm-small/model.gguf"
  export NEPALI_AI_TOKENIZER_PATH="$RESOURCES_DIR/models/llm-small/tokenizer.json"
fi

# 1. Start Modern Next.js Studio Standalone Server in background
if [ -n "$NODE_BIN" ] && [ -f "$STUDIO_SERVER_DIR/server.js" ]; then
  cd "$STUDIO_SERVER_DIR" || exit 1
  nohup "$NODE_BIN" server.js >/tmp/nepali_studio_server.log 2>&1 &
elif [ -d "$APP_DIR/../../studio" ] && [ -n "$NODE_BIN" ]; then
  cd "$APP_DIR/../../studio" || exit 1
  nohup "$NODE_BIN" node_modules/.bin/next start >/tmp/nepali_studio_server.log 2>&1 &
fi

# Wait up to 2 seconds for server to bind port
for _ in {1..20}; do
  if curl -s "http://127.0.0.1:$PORT" >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

# 2. Find nepali binary
if [ -x "$DIR/nepali" ]; then
  EXEC_BIN="$DIR/nepali"
elif [ -x "$HOME/.local/bin/nepali" ]; then
  EXEC_BIN="$HOME/.local/bin/nepali"
else
  EXEC_BIN="nepali"
fi

export NEPALI_BIN="$EXEC_BIN"

# 3. Exec into native binary so LaunchServices associates NSApplication with the .app bundle (stops bouncing)
if [ -n "$TARGET_FILE" ] && [ -f "$TARGET_FILE" ]; then
  exec "$EXEC_BIN" studio --window --port "$PORT" "$TARGET_FILE"
else
  exec "$EXEC_BIN" studio --window --port "$PORT"
fi
